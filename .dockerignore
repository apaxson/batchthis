# Keep the build context small and free of local state.
.git
.idea
.claude
.venv
.pytest_cache
.ruff_cache
**/__pycache__
**/*.pyc
**/.DS_Store
db.sqlite3
# Secrets stay out of the image; the container gets its settings from the environment.
.env
.env.*
!.env.example
media
log
staticfiles
screenshots
frontend/node_modules
node_modules
