# Batch This settings. Copy this file to .env and fill it in:
#   cp .env.example .env
# .env is never committed (.gitignore) and never copied into the Docker image.
# docker compose reads it automatically. After changing it, apply with
#   docker compose up -d
# (`docker compose restart` does NOT pick up changes to this file.)

# ---------- Required ----------

# Django's secret key. Replace this placeholder before the first start.
# Generate one (letters, digits, - and _ only, so no quoting problems):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# The database user. Leave it as batchthis - the database image creates that user.
POSTGRES_USER=batchthis
# The database password. Set it BEFORE the first `docker compose up`: it only takes
# effect when the database volume is first created. Changing it here later does not
# change the database's password. Generate one the same way as SECRET_KEY.
POSTGRES_PASSWORD=change-me

# Host names the site is reached by, comma-separated. No ports, no http:// -
# e.g. 127.0.0.1,localhost,batchthis,batchthis.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------- Optional ----------

# Only when the site is served over HTTPS (e.g. behind a reverse proxy): the full
# origin(s), scheme included, comma-separated - e.g. https://batchthis.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=

# Host port the site is published on (default 8080).
# APP_PORT=8080

# Gunicorn worker processes (default 3) and Django's log level (default INFO).
# GUNICORN_WORKERS=3
# DJANGO_LOG_LEVEL=INFO

# Local development only (python manage.py runserver). The Docker app always runs
# with DEBUG off, whatever this says.
DEBUG=off
